# BigShield AI - Backend Environment Configuration Template
# Copy this file to .env and configure your local settings.

# Backend Server Port
PORT=5000

# PostgreSQL Database Credentials
DB_USER=postgres
DB_HOST=localhost
DB_NAME=bigshield
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_PORT=5432

# AI Verification Microservice URL
AI_SERVICE_URL=http://localhost:8000
